# ============================================
# Railway 환경변수 설정
# ============================================
# Railway 대시보드 > Variables에서 설정하세요
# 아래 값들을 복사하여 사용

# Server (자동 설정됨)
NODE_ENV=production
PORT=3000
API_VERSION=v1

# ============================================
# Database - Railway PostgreSQL 추가 시 자동 설정
# ============================================
# Railway에서 PostgreSQL 추가하면 DATABASE_URL 자동 생성
# 아래 변수들은 DATABASE_URL에서 파싱하거나 개별 설정

# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_NAME=${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}

# 또는 개별 설정 (외부 DB 사용 시)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=hidden_growth
DB_USER=postgres
DB_PASSWORD=your_password

# ============================================
# Redis - Railway Redis 추가 시 자동 설정
# ============================================
# REDIS_URL=${{Redis.REDIS_URL}}

# 또는 개별 설정 (Upstash 등 외부 사용 시)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ============================================
# JWT - 반드시 변경!
# ============================================
# 생성: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# OAuth (선택사항 - 소셜 로그인 사용 시)
# ============================================
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# IAP (선택사항 - 인앱결제 사용 시)
# ============================================
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
GOOGLE_PLAY_PACKAGE_NAME=com.yourcompany.hiddengrowth
APPLE_SHARED_SECRET=
APPLE_BUNDLE_ID=com.yourcompany.hiddengrowth

# ============================================
# Security
# ============================================
ENCRYPTION_KEY=your_32_character_encryption_key!
HMAC_SECRET=your_hmac_secret_key

# ============================================
# Admin Dashboard
# ============================================
# 대시보드 접속: https://your-domain.railway.app/admin
ADMIN_SECRET_KEY=your_admin_secret_key_change_this

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
