              {
                "speaker": "시스템",
                "text": "[2차 각성 가능 - Lv.150]",
                "emotion": "알림"
              },
              {
                "speaker": "민수",
                "text": "아직 약하다는 건가... 더 강해져야 해!",
                "emotion": "각오"
              }
            ]
          }
        ]
      },
      "phase3": {
        "phaseName": "차원 헌터 (Lv.151~180)",
        "dialogues": [
          {
            "eventId": "arc2_phase3_001",
            "situation": "평행세계 자신과 만남",
            "characters": ["민수", "차원-A 민수", "차원-B 민수"],
            "lines": [
              {
                "speaker": "차원-A 민수",
                "text": "너도 이세계 귀환자구나",
                "emotion": "동질감"
              },
              {
                "speaker": "차원-B 민수",
                "text": "나는 정체를 끝까지 숨겼어",
                "emotion": "자랑"
              },
              {
                "speaker": "차원-C 민수",
                "text": "나는 처음부터 공개했지",
                "emotion": "당당"
              },
              {
                "speaker": "민수",
                "text": "수많은 가능성의 나...",
                "emotion": "경이"
              }
            ]
          }
        ]
      },
      "phase4": {
        "phaseName": "차원의 지배자 (Lv.181~200)",
        "dialogues": [
          {
            "eventId": "arc2_phase4_001",
            "situation": "미래의 자신과 대결",
            "characters": ["민수", "미래 민수"],
            "lines": [
              {
                "speaker": "미래 민수",
                "text": "결국... 너도 백수가 되지 못했구나",
                "emotion": "비웃음"
              },
              {
                "speaker": "민수",
                "text": "넌... 나야?!",
                "emotion": "충격"
              },
              {
                "speaker": "미래 민수",
                "text": "백수가 되지 못해 절망한 미래의 너다",
                "emotion": "절망"
              },
              {
                "speaker": "민수",
                "text": "그런 미래는... 바꾸겠어!",
                "emotion": "결의"
              }
            ]
          },
          {
            "eventId": "arc2_phase4_002",
            "situation": "미래 자신 패배",
            "characters": ["민수", "미래 민수"],
            "lines": [
              {
                "speaker": "미래 민수",
                "text": "...너는 꼭 백수가 되어라",
                "emotion": "간절"
              },
              {
                "speaker": "민수",
                "text": "...약속할게",
                "emotion": "다짐"
              },
              {
                "speaker": "시스템",
                "text": "[Arc 2 완료 - 차원 지배자 칭호]",
                "emotion": "달성"
              }
            ]
          }
        ]
      }
    },
    "rebirth_system": {
      "rebirthName": "환생 시스템",
      "dialogues": [
        {
          "eventId": "rebirth_001",
          "situation": "첫 환생 결심",
