{
  "version": "1.0.0",
  "description": "스토리 이벤트 및 상황별 대사 - 은둔형 백수 영웅",
  "storyArcs": {
    "arc1_awakening": {
      "arcName": "은둔의 시작 (Lv.1~100)",
      "phase1": {
        "phaseName": "가족 앞 백수 (Lv.1~30)",
        "dialogues": [
          {
            "eventId": "arc1_phase1_001",
            "situation": "첫 던전 입장",
            "characters": ["민수"],
            "lines": [
              {
                "speaker": "민수",
                "text": "새벽 3시... 이 시간이면 아무도 없겠지",
                "emotion": "긴장"
              },
              {
                "speaker": "민수",
                "text": "조용히... 들키면 안 돼",
                "emotion": "결의"
              }
            ]
          },
          {
            "eventId": "arc1_phase1_002",
            "situation": "어머니와 대화",
            "characters": ["민수", "어머니"],
            "lines": [
              {
                "speaker": "어머니",
                "text": "민수야, 오늘도 집에만 있니?",
                "emotion": "걱정"
              },
              {
                "speaker": "민수",
                "text": "네... 조금 쉬고 싶어요",
                "emotion": "거짓말",
                "thought": "(밤새 던전 돌며 피곤)"
              },
              {
                "speaker": "어머니",
                "text": "그래... 천천히 해도 괜찮아",
                "emotion": "이해"
              },
              {
                "speaker": "민수",
                "text": "...미안해요, 엄마",
                "emotion": "죄책감",
                "thought": "(진실을 말하고 싶지만...)"
              }
            ]
          },
          {
            "eventId": "arc1_phase1_003",
            "situation": "첫 레벨 10 달성",
            "characters": ["민수"],
            "lines": [
              {
                "speaker": "민수",
                "text": "레벨 10... 생각보다 강해지는데?",
                "emotion": "놀람"
              },
              {
                "speaker": "민수",
                "text": "하지만 아직 F급 수준... 더 강해져야 해",
                "emotion": "결의"
              },
              {
                "speaker": "민수",
                "text": "그리고... 절대 들키면 안 돼",
                "emotion": "다짐"
              }
            ]
          }
        ]
      },
      "phase2": {
        "phaseName": "야간의 사냥꾼 (Lv.31~60)",
        "dialogues": [
          {
            "eventId": "arc1_phase2_001",
            "situation": "민지의 의심",
            "characters": ["민수", "민지"],
            "lines": [
              {
                "speaker": "민지",
                "text": "오빠, 요즘 용돈 잘 쓰네?",
                "emotion": "의심"
              },
              {
                "speaker": "민수",
                "text": "아... 주식 좀 했어",
                "emotion": "당황",
                "thought": "(던전 수익 1억...)"
              },
              {
                "speaker": "민지",
                "text": "주식? 오빠가? 대박~",
                "emotion": "놀람"
              },
              {
                "speaker": "민수",
                "text": "응... 운이 좋았어",
                "emotion": "거짓말"
              }
            ]
          },
          {
            "eventId": "arc1_phase2_002",
            "situation": "첫 각성 (Lv.50)",
            "characters": ["민수", "시스템"],
            "lines": [
              {
                "speaker": "시스템",
                "text": "레벨 50 달성! 첫 번째 각성이 가능합니다!",
                "emotion": "알림"
              },
              {
                "speaker": "민수",
                "text": "각성...? 이게 뭐지?",
                "emotion": "놀람"
              },
              {
                "speaker": "시스템",
                "text": "새로운 힘이 깨어납니다. 스킬 트리가 확장됩니다!",
                "emotion": "설명"
              },
              {
                "speaker": "민수",
                "text": "오... 이 정도 힘이면... 아니 안 돼! 더 조심해야 해!",
                "emotion": "각오"
              }
            ]
          }
        ]
      },
      "phase3": {
        "phaseName": "도시의 유령 (Lv.61~90)",
        "dialogues": [
          {
            "eventId": "arc1_phase3_001",
            "situation": "수수께끼 헌터 소문",
            "characters": ["민수", "민지", "뉴스"],
            "lines": [
              {
                "speaker": "뉴스",
                "text": "정체불명 헌터, A급 던전 솔로 클리어!",
                "emotion": "보도"
              },
              {
                "speaker": "민지",
                "text": "오빠, 이 사람 대박! 근데... 체형이 오빠랑 비슷한데?",
                "emotion": "의심"
              },
              {
                "speaker": "민수",
                "text": "...우연이겠지?",
                "emotion": "식은땀",
                "thought": "(들켰나?!)"
              },
              {
                "speaker": "민지",
                "text": "그런가? 근데 진짜 닮았어~",
                "emotion": "관찰"
              }
            ]
          }
        ]
      },
      "phase4": {
        "phaseName": "정체의 공개 (Lv.91~100)",
        "dialogues": [
          {
            "eventId": "arc1_phase4_001",
            "situation": "민지 위기",
            "characters": ["민수", "민지", "S급 몬스터"],
            "lines": [
              {
                "speaker": "민지",
                "text": "크윽... 이런... S급 게이트가...!",
                "emotion": "공포"
              },
              {
                "speaker": "민수",
                "text": "민지가... 위험해!",
                "emotion": "긴장",
                "thought": "(이제 숨길 수 없어!)"
              },
              {
                "speaker": "민수",
                "text": "미안해 민지야... 사실은...",
                "emotion": "결심"
              }
            ]
          },
          {
            "eventId": "arc1_phase4_002",
            "situation": "정체 공개",
            "characters": ["민수", "민지"],
            "lines": [
              {
                "speaker": "민수",
                "text": "(마스크 벗으며) 민지야, 미안해. 사실은...",
                "emotion": "진지"
              },
              {
                "speaker": "민지",
                "text": "오...오빠?!?!",
                "emotion": "충격"
              },
              {
                "speaker": "민수",
                "text": "내가... 그 수수께끼 헌터였어",
                "emotion": "고백"
              },
              {
                "speaker": "민지",
                "text": "이게... 무슨...",
                "emotion": "혼란"
              },
              {
                "speaker": "시스템",
                "text": "[Arc 1 완료 - 영웅 칭호 획득]",
                "emotion": "달성"
              }
            ]
          }
        ]
      }
    },
    "arc2_dimension": {
      "arcName": "차원의 균열 (Lv.101~200)",
      "phase1": {
        "phaseName": "평화의 착각 (Lv.101~120)",
        "dialogues": [
          {
            "eventId": "arc2_phase1_001",
            "situation": "공개 활동 시작",
            "characters": ["민수", "민지"],
            "lines": [
              {
                "speaker": "민수",
                "text": "이게 내가 원한 백수 생활이 아닌데...",
