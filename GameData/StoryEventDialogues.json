          },
          {
            "eventId": "arc2_phase1_002",
            "situation": "국가 영웅 제안",
            "characters": ["민수", "대통령"],
            "lines": [
              {
                "speaker": "대통령",
                "text": "김민수 씨, 국가를 위해 일해주시겠습니까?",
                "emotion": "제안"
              },
              {
                "speaker": "민수",
                "text": "저... 그냥 백수하고 싶은데요...",
                "emotion": "난처"
              },
              {
                "speaker": "시스템",
                "text": "[강제 이벤트 - 거절 불가]",
                "emotion": "알림"
              },
              {
                "speaker": "민수",
                "text": "...하아",
                "emotion": "체념"
              }
            ]
          }
        ]
      },
      "phase2": {
        "phaseName": "균열의 예고 (Lv.121~150)",
        "dialogues": [
          {
            "eventId": "arc2_phase2_001",
            "situation": "차원 균열 발견",
            "characters": ["민수", "민지"],
            "lines": [
              {
                "speaker": "민지",
                "text": "오빠, 이번 적은 너무 강해...",
