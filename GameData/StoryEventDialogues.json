            }
          ]
        },
        {
          "eventId": "rebirth_003",
          "situation": "100회차 환생",
          "characters": ["민수", "시간 상인"],
          "lines": [
            {
              "speaker": "민수",
              "text": "100번째 환생... 백수가 뭐였더라?",
              "emotion": "허탈"
            },
            {
              "speaker": "시간 상인",
              "text": "아직도... 찾고 계시는군요",
              "emotion": "동정"
            },
            {
              "speaker": "민수",
              "text": "언젠간... 꼭 이루고 말겠어",
